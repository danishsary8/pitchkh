# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgres://pitchkh:pitchkh@localhost:5432/pitchkh
PORT=8000
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000
# Long random string: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Online payments. "sandbox" until a real provider is added (see src/payments.ts).
PAYMENT_PROVIDER=sandbox
# Random string; the provider signs its webhook calls with it.
PAYMENT_WEBHOOK_SECRET=change-me-too
# Optional: Telegram alerts for venue owners (create a bot with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back with each webhook call.
TELEGRAM_WEBHOOK_SECRET=
