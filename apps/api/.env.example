# Copy to .env and adjust. Never commit the real .env.
DATABASE_URL=postgres://pitchkh:pitchkh@localhost:5432/pitchkh
PORT=8000
# Comma-separated origins allowed to call the API (the web app).
CORS_ORIGINS=http://localhost:3000
# Long random string: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# The web app's URL (password reset links) and this API's public URL (photo links).
WEB_URL=http://localhost:3000
PUBLIC_URL=http://localhost:8000
# Venue photos. "local": saved in UPLOAD_DIR and served at /uploads/... (needs a persistent disk in production).
# "r2": saved in a Cloudflare R2 bucket (survives redeploys on free hosts). Set every R2_* value below.
STORAGE=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public URL: its r2.dev address or a custom domain, e.g. https://photos.pitchkh.app
R2_PUBLIC_URL=
# Optional: send emails with Resend. Without it, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM=PitchKH <no-reply@pitchkh.app>
# Online payments: "sandbox" (fake bank, for testing) or "bakong" (real KHQR).
PAYMENT_PROVIDER=sandbox
# Bakong KHQR (only with PAYMENT_PROVIDER=bakong). Token from https://api-bakong.nbc.gov.kh,
# account ID = the Bakong account that receives the money, e.g. yourname@aclb.
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=PitchKH
BAKONG_MERCHANT_CITY=Phnom Penh
# Random string; the provider signs its webhook calls with it.
PAYMENT_WEBHOOK_SECRET=change-me-too
# Optional: Telegram alerts for venue owners (create a bot with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string Telegram sends back with each webhook call.
TELEGRAM_WEBHOOK_SECRET=
