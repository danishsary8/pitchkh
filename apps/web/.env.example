# ---- Server-only secrets (set in Vercel → Settings → Environment Variables) ----
# Postgres connection string from Neon (Vercel → Storage → Neon, or neon.tech).
# Without it the app keeps bookings in memory (local development only; production refuses to start).
DATABASE_URL=
# Your bot's token from @BotFather. Used to verify who opens the Mini App and to send notifications.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed into /admin, comma-separated, e.g. 123456789,987654321.
# Don't know yours? Open /admin from the bot and it shows your ID.
ADMIN_TELEGRAM_IDS=

# ---- Public settings ----
# Your Telegram username (without @) for the "Chat with us on Telegram" button.
NEXT_PUBLIC_OWNER_TELEGRAM=
# The site's public address (links in bot messages and link previews).
NEXT_PUBLIC_SITE_URL=https://pitchkh.vercel.app
