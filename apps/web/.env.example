# "mock" (default): in-browser mock database. "real": call the backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Real mode only: extra features to show. The v1 API does not serve these yet
# (matches, chat, reviews), so leave empty until it does. Mock mode shows everything.
NEXT_PUBLIC_FEATURES=
