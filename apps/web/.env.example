# "mock" (default): in-browser mock database. "real": call the backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Only when the API stores photos in Cloudflare R2 (STORAGE=r2): the bucket's public URL, same as R2_PUBLIC_URL.
NEXT_PUBLIC_PHOTOS_URL=
# Optional: hide features in this deployment, e.g. "chat" or "matches,reviews".
NEXT_PUBLIC_FEATURES_OFF=
# Show one-tap demo accounts on the login page. Default: on in mock mode, off in real mode.
# Never set to 1 in production.
NEXT_PUBLIC_DEMO_LOGIN=
# Invite link of the Telegram group where matches are posted (match board banner).
# Default is a placeholder: https://t.me/pitchkh_matches
NEXT_PUBLIC_TELEGRAM_GROUP_URL=
