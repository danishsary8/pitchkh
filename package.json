{
  "name": "pitchkh",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @pitchkh/web dev",
    "build": "pnpm --filter @pitchkh/web build",
    "start": "pnpm --filter @pitchkh/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @pitchkh/shared test",
    "check": "node scripts/i18n-merge.mjs && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  }
}
